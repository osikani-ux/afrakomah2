# MediCore HMS — Supabase connection (optional)
# The publishable key is already wired into the app. You can also
# connect at runtime: Settings -> Database -> paste the Project URL.
#
# To pin the connection at build time instead:
# 1. Create a project at https://supabase.com
# 2. Run schema.sql (repo root) in the Supabase SQL editor
# 3. Copy this file to .env and fill in your values
# 4. Rebuild — the app boots from Postgres and syncs every change.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
